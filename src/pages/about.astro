---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, names, links, release } from '../../site.config.mjs';

const principles = [
  ['layers', 'Standard parts, put together carefully', `Arch Linux packages from a fixed snapshot, Arch’s standard kernel and KDE’s standard desktop. ${site.name} adds the glue and the safety net, not another flavour to learn.`],
  ['back', 'Always a way back', 'Every change can be undone: updates keep the previous version, snapshots keep your files, and the repair tools work even when the system doesn’t start.'],
  ['eye', 'Honest and plain', 'Apps say what they do in plain words, show real information or say they can’t, and explain exactly what a reset or a wipe will remove.'],
  ['lock', 'Private by default', `The system doesn’t phone home. ${names.updater} never looks online by itself; ${names.hub}, the one online app, is optional.`],
];

const faq = [
  ['Is it free?', `Yes. ${site.name} is free to download and use, and its code is open under the GPL-3.0-or-later.`],
  ['Is it ready to use?', `Not yet for anything important. It is being tested on real PCs; the first public release comes when those tests say it’s ready. <a href="/news/">The news</a> says when.`],
  ['Is it Arch Linux?', `It is built from Arch Linux packages, pinned to one snapshot and tested together, but it works differently: the system is one read-only image updated as a whole, and there is no package manager to install into it. Apps come from Flathub, Snap, AppImage, Nix and containers.`],
  ['Can I install it next to Windows?', `On another disk, yes. ${site.name} uses the whole disk you choose and never shares a disk with Windows, so neither can break the other. ${names.maintenance} can make sure the PC starts ${site.name} first.`],
  ['Do I need Secure Boot or a TPM chip?', 'No. Both make it safer, and are used when the PC has them. Without a TPM chip, you type the disk’s passphrase at every start.'],
  ['How do I install programs?', `Most apps come from Flathub through Discover. Snap and AppImage work too, Nix has command-line tools, and Distrobox gives you any distribution’s packages in a container.`],
  ['Does it work with NVIDIA graphics?', 'Yes: GTX 16xx, RTX 20xx and newer use NVIDIA’s own driver, signed so it loads with Secure Boot. Older NVIDIA cards use the open drivers, which are fine for the desktop but weak for games.'],
  ['What if an update goes wrong?', `If the new version doesn’t start three times in a row, the PC goes back to the previous one by itself. You can also go back by hand in ${names.updater}, or repair everything from ${names.rescue}.`],
  ['Where do updates come from?', `Each update is one file signed by the build that made your system; ${site.name} refuses any other. ${names.hub} downloads them, or you bring the file yourself.`],
  ['Who makes it?', `${site.name} is an independent project, built in the open. It is not affiliated with Arch Linux or KDE, whose work it builds on.`],
];

const faqJson = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })),
};
---
<Base title="About" description={`What ${site.longName} is, the ideas behind it, and answers to common questions.`}>
  <JsonLd data={faqJson} />
  <section class="container page-head">
    <p class="eyebrow">About</p>
    <h1>A computer that just keeps working</h1>
    <p class="lead">
      {site.name} started from a simple wish: an operating system you install once and then stop worrying about. Updates
      shouldn&rsquo;t be a gamble, repairs shouldn&rsquo;t need an expert, and your files should never be at risk.
    </p>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head"><h2>What guides every decision</h2></div>
      <div class="grid grid-2">
        {principles.map(([icon, title, text]) => (
          <div class="card">
            <span class="icon-tile"><Icon name={icon} /></span>
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Built in the open</h2>
        <p class="lead">The code, the design of every app, the decisions and the test results are public.</p>
      </div>
      <ul class="doc-links">
        <li><a href={links.architecture}><strong>How it works</strong><span>Disk layout, start-up, signing keys, updates and going back</span></a></li>
        <li><a href={links.decisions}><strong>Goals and decisions</strong><span>Every decision and why it was made</span></a></li>
        <li><a href={links.status}><strong>What works today</strong><span>Each capability and test, with its result</span></a></li>
        <li><a href={links.roadmap}><strong>Roadmap</strong><span>What comes next</span></a></li>
        <li><a href={links.code}><strong>Source code</strong><span>GPL-3.0-or-later, on GitHub</span></a></li>
      </ul>
    </div>
  </section>

  <section id="questions" class="section section-alt">
    <div class="container faq-wrap">
      <div class="section-head"><h2>Questions</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p set:html={a} />
          </details>
        ))}
      </div>
      <p class="muted">Base of the version being tested: Arch Linux packages from {release.base.snapshot}, systemd {release.base.systemd}, Linux {release.base.kernel}, KDE Plasma {release.base.plasma}.</p>
    </div>
  </section>
</Base>

<style>
  .doc-links { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .doc-links a {
    display: grid; gap: 2px; padding: 16px 20px;
    border: 1px solid var(--border); border-radius: var(--radius-m);
    background: var(--surface); color: var(--text); text-decoration: none;
  }
  .doc-links a:hover { border-color: var(--border-strong); background: var(--surface-hover); }
  .doc-links span { color: var(--text-muted); font-size: 0.9375rem; }
  .faq-wrap { max-width: 56rem; }
  .faq { display: grid; gap: 12px; margin-bottom: 32px; }
  .faq details { border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--surface); }
  .faq summary {
    cursor: pointer; padding: 18px 52px 18px 20px; position: relative;
    font-weight: 650; list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%);
    font-size: 1.5rem; font-weight: 400; color: var(--text-muted);
  }
  .faq details[open] summary::after { content: '\2212'; }
  .faq details p { margin: 0; padding: 0 20px 20px; color: var(--text-muted); }
</style>
