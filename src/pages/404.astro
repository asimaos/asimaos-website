---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="container page-head lost">
    <p class="eyebrow">404</p>
    <h1>This page isn&rsquo;t here</h1>
    <p class="lead">It may have moved, or the address may have a typo.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Go to the start page</a>
      <a class="btn btn-secondary" href="/search/"><Icon name="search" />Search the site</a>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 55vh; }
</style>
