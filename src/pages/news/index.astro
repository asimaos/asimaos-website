---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../../site.config.mjs';

const posts = (await getCollection('news', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="News" description={`News about ${site.name}: releases, what changed, and what comes next.`}>
  <section class="container page-head">
    <p class="eyebrow">News</p>
    <h1>What&rsquo;s new</h1>
    <p class="lead">Releases, what changed, and what comes next.</p>
    <p><a class="btn btn-secondary" href="/news/rss.xml"><Icon name="rss" />RSS feed</a></p>
  </section>
  <section class="container news-list">
    {posts.map((p) => (
      <a class="card card-link post" href={`/news/${p.id}/`}>
        <time datetime={p.data.date.toISOString().slice(0, 10)}>{day(p.data.date)}</time>
        <h2>{p.data.title}</h2>
        <p class="muted">{p.data.description}</p>
        <span class="read">Read it <Icon name="arrow" size={18} /></span>
      </a>
    ))}
  </section>
</Base>

<style>
  .news-list { display: grid; gap: 20px; max-width: 52rem; padding-bottom: 96px; }
  .post time { color: var(--text-muted); font-size: 0.9375rem; }
  .post h2 { margin: 6px 0 8px; font-size: 1.5rem; }
  .read { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-text); font-weight: 600; }
</style>
