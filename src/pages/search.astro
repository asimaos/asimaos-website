---
// The site search: Pagefind's index (built after the site, `npm run build`), searched in the browser.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../../site.config.mjs';
---
<Base title="Search" description={`Search the ${site.name} website and guides.`} noindex>
  <section class="container page-head search-page">
    <h1>Search</h1>
    <form class="search-box" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="q">Search the site</label>
      <Icon name="search" />
      <input id="q" name="q" type="search" autocomplete="off" placeholder="Search guides, features, news…" autofocus />
    </form>
    <p class="status muted" aria-live="polite" data-status></p>
    <ol class="results" data-results></ol>
  </section>
</Base>

<script>
  type Result = { url: string; meta: { title?: string }; excerpt: string };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (q: string) => Promise<{ results: { data: () => Promise<Result> }[] } | null>;
  };

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const list = document.querySelector<HTMLOListElement>('[data-results]')!;
  let pagefind: Pagefind | null = null;

  async function load(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      const url = new URL('/pagefind/pagefind.js', location.href).href;
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
      await pagefind.init();
      return pagefind;
    } catch {
      status.textContent = 'The search is available on the published site (its index is made when the site is built).';
      return null;
    }
  }

  // Pagefind marks the matching words with <mark>; everything else in the excerpt is escaped text.
  function excerpt(html: string): DocumentFragment {
    const fragment = document.createDocumentFragment();
    for (const part of html.split(/(<mark>.*?<\/mark>)/g)) {
      const match = part.match(/^<mark>(.*)<\/mark>$/);
      const text = document.createElement('textarea');
      text.innerHTML = match ? match[1] : part;
      if (match) {
        const mark = document.createElement('mark');
        mark.textContent = text.value;
        fragment.append(mark);
      } else {
        fragment.append(text.value);
      }
    }
    return fragment;
  }

  async function search(query: string) {
    const engine = await load();
    if (!engine) return;
    const q = query.trim();
    list.replaceChildren();
    if (!q) { status.textContent = ''; return; }
    const found = await engine.debouncedSearch(q);
    if (!found) return; // a newer search replaced this one
    const results = await Promise.all(found.results.slice(0, 20).map((r) => r.data()));
    status.textContent = results.length ? `${results.length} result${results.length === 1 ? '' : 's'}` : 'Nothing found. Try other words.';
    for (const r of results) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = r.url;
      a.textContent = r.meta.title ?? r.url;
      const p = document.createElement('p');
      p.append(excerpt(r.excerpt));
      li.append(a, p);
      list.append(li);
    }
  }

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; search(initial); }
  input.addEventListener('input', () => {
    const url = new URL(location.href);
    if (input.value) url.searchParams.set('q', input.value); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    search(input.value);
  });
  document.querySelector('.search-box')?.addEventListener('submit', (event) => event.preventDefault());
</script>

<style>
  .search-page { max-width: 52rem; min-height: 60vh; }
  .search-box {
    display: flex; align-items: center; gap: 12px;
    padding: 0 18px;
    border: 1px solid var(--border-strong); border-radius: var(--radius-l);
    background: var(--surface); color: var(--text-muted);
    box-shadow: var(--shadow-s);
  }
  .search-box:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 25%, transparent); }
  .search-box input {
    flex: 1; min-width: 0; padding: 16px 0;
    border: 0; outline: 0; background: transparent;
    color: var(--text); font: inherit; font-size: 1.125rem;
  }
  .status { margin: 16px 0 8px; }
  .results { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .results :global(li) { padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--surface); }
  .results :global(a) { font-weight: 650; font-size: 1.0625rem; }
  .results :global(p) { margin: 6px 0 0; color: var(--text-muted); font-size: 0.96rem; }
  .results :global(mark) { background: var(--accent-soft); color: var(--text); border-radius: 3px; padding: 0 2px; }
</style>
