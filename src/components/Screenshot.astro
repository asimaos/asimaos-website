---
// An app screenshot in light and dark (src/assets/screens/<name>-light|dark.png). The one matching
// the site's theme shows; the other is never downloaded (it stays hidden and loads lazily).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { name, alt, caption, eager = false, sizes = '(min-width: 1200px) 700px, (min-width: 960px) 58vw, 100vw', class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const pick = (theme: 'light' | 'dark') => {
  const file = files[`../assets/screens/${name}-${theme}.png`];
  if (!file) throw new Error(`missing screenshot: ${name}-${theme}.png (scripts/import-screenshots.sh)`);
  return file.default;
};
const light = pick('light');
const dark = pick('dark');
const widths = [480, 720, 960, light.width].filter((w, i, all) => w <= light.width && all.indexOf(w) === i);
---
<figure class:list={['shot', className]}>
  <Picture class="light" src={light} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  <Picture class="dark" src={dark} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']}
    loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
