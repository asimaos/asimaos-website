if (!(name in icons)) throw new Error(`unknown icon: ${name}`);
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
{name === 'github' ? (
  <svg class={className} width={size} height={size} viewBox="0 0 16 16" fill="currentColor" {...a11y}><path d={githubPath} /></svg>
) : (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...a11y}
    set:html={icons[name]}
  />
)}
